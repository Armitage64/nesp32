+    adc $0E
+    sta $08
+    txa
+    adc $0F
+    sta $09
+    iny
+    ldx #$00
+    lda ($2E),y
+    bpl :+
+    dex
+:   clc
+    adc $10
+    sta $0A
+    txa
+    adc $11
+    sta $0B
+    inc $1A
+    ldx $052D
+    ora $09
+    bne @off
+    lda $08
+    cmp #$04
+    bcc @off
+    lda $0A
+    cmp #$33
+    bcc @off
+    lda #$EC                    ; (the game's: ~($0A + 3) - $10)
+    sbc $0A
+    sta $0200,x
+    lda $08
+    sec
+    sbc #$04
+    sta $0203,x
+    txa
+    sbc #$04
+    sta $052D
+    cmp #$04
+    beq L7_EF84
+    bne L7_EF66
+@off:
+    lda #$F8
+    sta $0200,x
+    bne L7_EF66
+    .res $EF66 - $EEDC - (* - L7_EEDC), $EA
+.else
