--- a/src/header.asm
+++ b/src/header.asm
@@ -1,0 +2,19 @@
+.ifdef NETPLAY
+; The netplay ROM is on the game's own board, an MMC3 with 8 KB of RAM
+; kept by a battery, and twice the game's PRG ROM for the room
+; (net/superbowl_net.cfg). It has an NES 2.0 header: mapper 4 with no
+; submapper, 512 KB of PRG ROM and the game's 128 KB of CHR ROM, 8 KB of
+; PRG RAM kept by the battery and none that is not, and NTSC timing. The
+; MMC3 sets the mirroring.
+    .byte $4E,$45,$53,$1A
+    .byte $20 ;32 banks of 16 KB of PRG ROM
+    .byte $10 ;16 banks of 8 KB of CHR ROM
+    .byte $42 ;mapper 4 (MMC3), low bits; a battery
+    .byte $08 ;NES console, NES 2.0 header
+    .byte $00 ;mapper high bits and submapper
+    .byte $00 ;PRG and CHR ROM size high bits
+    .byte $70 ;PRG RAM: none; kept by the battery: 64 << 7 bytes
+    .byte $00 ;no CHR RAM
+    .byte $00 ;NTSC
+    .byte $00,$00,$00
+.else
@@ -2,0 +22 @@
+.endif
