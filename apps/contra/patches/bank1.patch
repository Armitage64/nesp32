--- a/src/bank1.asm
+++ b/src/bank1.asm
@@ -12,0 +13,7 @@
+.ifdef NETPLAY
+.ifndef NET_SLOW
+NET_FAST = 1 ; the sprite pass is net/sprites.inc's
+.import net_sprites
+.endif
+.export sprite_ptr_tbl_0, sprite_ptr_tbl_1, hud_sprites, sprite_medal_x_offset
+.endif
@@ -3998,0 +4006,4 @@
+.ifdef NET_FAST
+    jmp net_sprites              ; all of it from the PRG RAM, faster (net/sprites.inc), in the
+                                 ; bytes of the two that follow, so that nothing moves
+.else
@@ -4000,0 +4012 @@
+.endif
@@ -4015,0 +4028,29 @@
+.ifdef NETPLAY
+; The same, with less done for a slot with no sprite, which is most of
+; them: a frame has fewer cycles to spare in a session (net/net.inc).
+; $05 and Y are left as the game's loop leaves them. The OAM's room ($07)
+; is looked at only after a sprite, where it can have run out: the HUD
+; before the loop takes 8 of its 64 at the most.
+@load_sprite_loop:
+    lda CPU_SPRITE_BUFFER,x    ; load sprite offset into sprite_ptr_tbl
+    beq @next_sprite           ; none in this slot
+    stx $05
+    ldy SPRITE_ATTR,x
+    sty $00
+    ldy SPRITE_Y_POS,x
+    sty $01
+    ldy SPRITE_X_POS,x
+    sty $02
+    jsr load_sprite_to_cpu_mem
+    ldy $07
+    bmi draw_sprites_exit      ; the OAMDMA is full
+    ldx $05
+
+@next_sprite:
+    dex
+    bpl @load_sprite_loop
+    inx
+    stx $05                    ; the last slot, 0
+    ldy $07
+    ldx $04
+.else
@@ -4035,0 +4077 @@
+.endif
@@ -4040,0 +4083,6 @@
+.ifdef NETPLAY
+    txa                     ; adv_OAMDMA_addr, in line
+    clc
+    adc #$c4
+    tax
+.else
@@ -4041,0 +4090 @@
+.endif
@@ -4110,0 +4160,3 @@
+.ifdef NETPLAY
+    bne @have_y   ; not shared: A is the Y offset already
+.else
@@ -4111,0 +4164 @@
+.endif
@@ -4127,0 +4181,3 @@
+.ifdef NETPLAY
+@have_y:
+.endif
@@ -4172,0 +4229,8 @@
+.ifdef NETPLAY
+    sta OAMDMA_CPU_BUFFER+3,x ; set_x_adv_OAMDMA_addr, in line
+    dec $07
+    txa
+    clc
+    adc #$c4
+    tax
+.else
@@ -4173,0 +4238 @@
+.endif
