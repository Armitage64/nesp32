--- a/src/bank7.asm
+++ b/src/bank7.asm
@@ -16,0 +17,6 @@
+.ifdef NETPLAY
+.ifndef NET_SLOW
+NET_FAST = 1 ; the bullets' test against an enemy is net/collide.inc's
+.endif
+.endif
+
@@ -226,0 +233,5 @@
+.ifdef NETPLAY
+    lda #$00    ; no NMI until the memory is cleared: a cartridge that starts the game from a
+    sta PPUCTRL ; menu of its own may leave it on, and the handler would act on what it found
+    sta PPUMASK ; (net_menu, net_stalled) before the reset had set it
+.endif
@@ -249,0 +261,4 @@
+.ifdef NETPLAY
+    jsr net_cart_reset       ; the netplay's code into the PRG RAM; OUT0 to mark for the nesp32,
+                             ; and into a session if one was asked for
+.endif
@@ -284,0 +300,3 @@
+.ifdef NETPLAY
+    jmp forever_loop  ; RANDOM_NUM is stirred once a frame instead (net_read_input)
+.else
@@ -288,0 +307 @@
+.endif
@@ -301,0 +321,6 @@
+.ifdef NETPLAY
+    lda net_menu                         ; the netplay menu has the console (net/net.inc)
+    beq :+
+    jmp net_menu_nmi
+:
+.endif
@@ -305,0 +331,6 @@
+.ifdef NETPLAY
+    lda net_stalled                      ; the last NMI stopped short of the game, for want of the
+    beq :+                               ; other console's buttons: the PPU has had its writes
+    jmp net_nmi_stalled                  ; (net/net.inc)
+:
+.endif
@@ -330,0 +362,5 @@
+.ifdef NETPLAY
+net_nmi_tick:
+    jsr net_read_input                 ; the same, or both consoles' buttons in a session (net/net.inc)
+    bcs net_nmi_end                    ; a session without the buttons for this tick: no game this NMI
+.else
@@ -331,0 +368 @@
+.endif
@@ -336,0 +374,3 @@
+.ifdef NETPLAY
+net_nmi_end:
+.endif
@@ -373,0 +414,3 @@
+.ifdef NETPLAY
+    jsr net_lag_leave                       ; the same, and a switch broken into begun again (net/cart.inc)
+.else
@@ -374,0 +418 @@
+.endif
@@ -473,0 +518,4 @@
+.ifdef NETPLAY
+    jmp net_set_bank    ; on the netplay ROM's MMC3 (net/cart.inc); the same length, so nothing moves
+    .byte $ff,$ff,$ff
+.else
@@ -475,0 +524 @@
+.endif
@@ -1014,0 +1064,4 @@
+.ifdef NETPLAY
+    ldx #$00         ; the strobe rests high, which is mark to a nesp32 on port 2,
+    stx CONTROLLER_1 ; and is low only for the reads
+.else
@@ -1018,0 +1072 @@
+.endif
@@ -1045,0 +1100,4 @@
+.ifdef NETPLAY
+    ldx #$01
+    stx CONTROLLER_1 ; back to mark
+.endif
@@ -1063,0 +1122,4 @@
+.ifdef NETPLAY
+    jsr net_title_start                      ; 2 PLAYERS goes to the netplay menu first (net/net.inc)
+    bcs timer_exit
+.endif
@@ -6954,0 +7017,3 @@
+.ifdef NET_FAST
+    jmp net_bullets             ; from the PRG RAM, faster (net/collide.inc); the same length
+.else
@@ -6955,0 +7021 @@
+.endif
@@ -10687,0 +10754,5 @@
+.ifdef NETPLAY
+    .include "cart.inc"
+    .include "net.inc"
+.endif
+
@@ -10800 +10871,5 @@
-  .addr nmi_start, reset_vector, irq
\ No newline at end of file
+.ifdef NETPLAY
+  .addr nmi_start, net_cart_start, irq ; the MMC3 set up first (net/cart.inc)
+.else
+  .addr nmi_start, reset_vector, irq
+.endif
\ No newline at end of file
