# The link task sleeps on the UART's queue and must wake within a fraction
# of a millisecond; a 1 kHz tick keeps every other wait short too.
CONFIG_FREERTOS_HZ=1000
# The UART's interrupt handler stays in RAM, so that a flash write (saving a
# network) cannot hold up a byte.
CONFIG_UART_ISR_IN_IRAM=y
# Wi-Fi on core 0; the link task has core 1 to itself (main/link.c).
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
# FreeRTOS's functions and the ring buffer's run from RAM. Each request
# goes through them: the link task waits on the UART's event queue, reads
# the request from the driver's receive ring buffer and writes the reply to
# its transmit one, and from flash any of those calls can wait on a cache
# miss. ESP-IDF 6 puts both in flash by default and keeps in RAM only what
# interrupts and the scheduler call; these two bring the rest back, for
# about 11 KB of internal RAM. ESP-IDF 5.5 kept them in RAM without being
# asked: FreeRTOS through a hidden option that defaults to y, the ring
# buffer because RINGBUF_PLACE_FUNCTIONS_INTO_FLASH defaults to n. 5.5 has
# no RINGBUF_IN_IRAM and warns of an unknown symbol.
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_RINGBUF_IN_IRAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The files are FAT, for a computer to read when the partition is lent to
# it as a drive: with the names people give music, and in sectors of 512
# bytes, which is what every computer takes a drive's to be. The wear
# levelling is left in its safe mode, the slower one: a drive gets its cable
# pulled.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_WL_SECTOR_SIZE_512=y

# Built for speed, not size: the 80 KB that building for size saves was
# judged not worth what it might cost.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# What a Stick never does: be an access point, join an enterprise network
# (NET's scan marks those as not joinable), or use IPv6.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_MBO_SUPPORT=n
CONFIG_ESP_WIFI_WAPI_PSK=n
CONFIG_LWIP_IPV6=n
# Left as they are until the firmware has been through its bring-up, since
# they are what a crash is read from; together they are worth about 95 KB:
#   CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
#   CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
#   CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y

# The services are TLS clients only, of TLS 1.2 (ESP-IDF's default leaves
# 1.3 out); the firmware is never a TLS server. Renegotiation is left out
# too: esp-tls turns it on whenever Mbed TLS has it, and without it a
# server's HelloRequest is answered with a no_renegotiation warning and the
# connection carries on.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
# Only the elliptic curves in use: X25519 and P-256, which the services'
# servers choose for the key exchange, and P-256, P-384 and P-521, which
# their certificates and the bundle's roots have keys on. None of them
# uses secp256k1 or a Brainpool curve.
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
# The roots servers are checked against: Mozilla's list, vendored in
# ca/cacert.pem (ca/README.md, tests/test_firmware_ca.py), not ESP-IDF's,
# which lags Mozilla's removals (6.0.3's still has the emSign roots Mozilla
# removed). Cross-signed verification, ESP-IDF's default, stays on: some
# servers send a chain whose top is issued by a root Mozilla no longer has.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="ca/cacert.pem"

# The PSRAM both boards have, for what is too big for the chip's own memory
# (an article is a quarter of a megabyte). A board whose PSRAM does not
# answer still starts, and the services make do with less.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# A game's packets are a few bytes and wanted at once: the radio is not to
# hold one back to send it with others.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
