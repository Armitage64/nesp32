# The StickS3's ESP32-S3-PICO-1-N8R8: 8 MB of octal PSRAM.
CONFIG_SPIRAM_MODE_OCT=y
# The files as a USB drive (main/usb.c).
CONFIG_TINYUSB_MSC_ENABLED=y
# What the computer writes, taken a flash sector at a time: in pieces of 512
# bytes each one costs an erase of the sector it is in.
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="nesp32"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="nesp32"
CONFIG_TINYUSB_DESC_MSC_STRING="nesp32 files"

# Bluetooth, for a keyboard (main/keyboard.c). The chip has Bluetooth LE
# and no Classic, so only LE keyboards can pair. NimBLE is the smaller of
# ESP-IDF's two stacks; the nesp32 is a central and scans.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# esp_hid's host on NimBLE is built only with NimBLE's HID service, which
# ESP-IDF offers only with a GATT server, which it offers only to a
# peripheral: so the nesp32 can be one, and never is.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
# The keyboard it was paired with, kept over power-off.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# The host's memory from PSRAM: the chip's own is Wi-Fi's and the link's.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# A read the keyboard refuses until it is paired is read again once it is.
CONFIG_BT_NIMBLE_GATTC_AUTO_PAIR=y
# Wi-Fi and Bluetooth take turns at the one radio.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
